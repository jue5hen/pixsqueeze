{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixSqueeze",
  "version": "1.0.0",
  "identifier": "com.dsh.pixsqueeze",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PixSqueeze v1.0.0 — 图片批量压缩工具",
        "width": 1320,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 660,
        "resizable": true,
        "maximizable": true,
        "center": true,
        "backgroundColor": "#f5f6f8",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
